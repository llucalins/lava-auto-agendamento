# Required only by server-side PostgreSQL access. Replace every placeholder locally.
DATABASE_URL=postgresql://app:change-me@localhost:5432/lava_auto
# Privileged migration/retention authority; never expose to application runtime or browser code.
MIGRATION_DATABASE_URL=postgresql://migrator:change-me@localhost:5432/lava_auto
# Exact canonical browser origin. Production must use HTTPS.
APP_ORIGIN=http://localhost:3000
# Server-only keyed fingerprint material (at least 32 random base64url bytes).
CONFIRMATION_FINGERPRINT_KEY=replace-with-at-least-32-random-bytes-in-base64url
# Server-only versioned HMAC key for tracking credential verification (base64url, at least 32 random bytes).
TRACKING_VERIFIER_KEY_VERSION=1
TRACKING_VERIFIER_KEY=replace-with-at-least-32-random-bytes-in-base64url
# Provider-approved OIDC Authorization Code + PKCE endpoints and client configuration.
OIDC_ISSUER=https://identity.example.test
OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.test/authorize
OIDC_TOKEN_ENDPOINT=https://identity.example.test/token
OIDC_JWKS_URI=https://identity.example.test/.well-known/jwks.json
OIDC_CLIENT_ID=replace-with-provider-client-id
OIDC_CLIENT_SECRET=replace-only-if-provider-requires-a-confidential-client
OIDC_REDIRECT_URI=https://app.example.test/api/admin/auth/callback

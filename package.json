{
  "name": "lava-auto-agendamento",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --passWithNoTests",
    "test:browser": "node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test --pass-with-no-tests"
    ,"migrate": "node --env-file=.env.local ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -d MIGRATION_DATABASE_URL -m database/migrations -t lava_migrations --single-transaction"
  },
  "dependencies": {
    "next": "16.3.2",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
